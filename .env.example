# Copy this file to .env and fill in your Azure AI Foundry deployment values.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Azure Foundry image deployment. Endpoint and key fall back to AZURE_OPENAI_*.
AZURE_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_IMAGE_QUALITY=medium
AZURE_IMAGE_API_VERSION=2025-04-01-preview
