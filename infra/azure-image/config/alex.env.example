# Host initialization. Leave passwords empty to generate random values.
ALEX_INITIAL_USERNAME=msuser
ALEX_INITIAL_PASSWORD=
ALEX_INGRESS_USERNAME=msuser
ALEX_INGRESS_PASSWORD=

# Unknown/private repositories must be supplied explicitly.
QWEN_LLM_REPO=
MINIMAX_H3_REPO=
HF_TOKEN=

# vLLM remains stopped until its job is submitted manually.
VLLM_MODEL=/opt/alex-data/models/huggingface/qwen-3.8-27b
VLLM_PORT=8000
